{
  "name": "tornadoc2-desktop",
  "version": "0.9.0",
  "private": true,
  "description": "TornadoC2 Electron shell",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start": "electron-vite preview",
    "fuses": "node scripts/fuses.mjs",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/ensure-electron.mjs",
    "setup": "node scripts/ensure-electron.mjs",
    "predev": "node scripts/ensure-electron.mjs",
    "prebuild": "node scripts/ensure-electron.mjs",
    "predist": "node scripts/ensure-electron.mjs",
    "dev:headless": "cross-env NO_SANDBOX=1 ELECTRON_CLI_ARGS='[\"--ozone-platform=headless\",\"--disable-gpu\"]' electron-vite dev",
    "start:headless": "cross-env NO_SANDBOX=1 ELECTRON_CLI_ARGS='[\"--ozone-platform=headless\",\"--disable-gpu\"]' electron-vite preview",
    "audit:contrast": "node scripts/contrast-audit.mts",
    "verify": "npm run typecheck && npm run audit:contrast && npm test",
    "budget": "node scripts/bundle-budget.mts",
    "smoke:viewports": "node scripts/viewport-smoke.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.28",
    "d3-force": "^3.0.1",
    "dompurify": "^3.5.0",
    "electron-updater": "^6.8.11",
    "marked": "^18.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/d3-force": "^3.0.10",
    "@types/dompurify": "^3.0.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "axe-core": "^4.14.1",
    "cross-env": "^10.1.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
  "build": {
    "appId": "io.tornadoc2.desktop",
    "productName": "TornadoC2",
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "category": "Network",
      "maintainer": "kamalx06",
      "synopsis": "TornadoC2 operator console",
      "executableName": "tornadoc2-desktop",
      "syncDesktopName": true
    },
    "win": {
      "target": [
        "nsis",
        "msi"
      ]
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "../tornado_client",
        "to": "t2/tornado_client"
      },
      {
        "from": "../tornadoc2_mcp",
        "to": "t2/tornadoc2_mcp"
      },
      {
        "from": "../beacon-client.py",
        "to": "t2/beacon-client.py"
      }
    ],
    "afterPack": "scripts/afterPack.mjs",
    "publish": [
      {
        "provider": "github",
        "owner": "kamalx06",
        "repo": "TornadoC2"
      }
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "icon": "build/icon.png"
  },
  "author": "kamalx06",
  "homepage": "https://github.com/kamalx06/TornadoC2",
  "allowScripts": {
    "electron": true,
    "esbuild": true,
    "electron-winstaller": true
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  },
  "desktopName": "tornadoc2-desktop.desktop"
}
