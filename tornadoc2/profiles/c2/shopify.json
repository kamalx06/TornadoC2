{
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "linux_user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",

  "beacon_path":  "/admin/api/2024-01/products.json",
  "tasks_path":   "/admin/api/2024-01/orders.json",
  "results_path": "/admin/api/2024-01/customers.json",

  "extra_headers": {
    "Accept": "application/json",
    "X-Shopify-Access-Token": "shpat_00000000000000000000000000000000"
  },
  "request_headers": {},

  "response_headers": {
    "Server": "nginx",
    "X-ShopId": "00000000",
    "X-ShardId": "0",
    "X-Shopify-Shop-Api-Call-Limit": "1/40",
    "X-Request-Id": "00000000-0000-0000-0000-000000000000"
  },

  "shaping": {
    "checkin_response": {
      "template": {
        "products": [
          {
            "id": 1000000001,
            "title": "{{payload}}",
            "body_html": "",
            "vendor": "shop"
          }
        ]
      },
      "extract": "products[0].title"
    },
    "tasks_response": {
      "template": {
        "orders": [
          {
            "id": 2000000001,
            "name": "{{nonce}}",
            "note": "{{payload}}",
            "financial_status": "paid"
          }
        ]
      },
      "extract": "orders[0].note"
    },
    "results_request": {
      "template": {
        "customer": {
          "first_name": "{{nonce}}",
          "last_name": "Result",
          "note": "{{payload}}"
        }
      },
      "extract": "customer.note"
    }
  }
}