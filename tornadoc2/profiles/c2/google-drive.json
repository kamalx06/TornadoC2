{
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "linux_user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",

  "beacon_path":  "/drive/v3/files",
  "tasks_path":   "/drive/v3/files/list",
  "results_path": "/upload/drive/v3/files",

  "extra_headers": {
    "Accept": "application/json",
    "Authorization": "Bearer ya29.a0AfH6SMB..."
  },
  "request_headers": {},

  "response_headers": {
    "Server": "ESF",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "SAMEORIGIN"
  },

  "shaping": {
    "checkin_response": {
      "template": {
        "files": [
          {
            "id": "1abcd",
            "name": "{{payload}}",
            "mimeType": "application/vnd.google-apps.document"
          }
        ],
        "incompleteSearch": false
      },
      "extract": "files[0].name"
    },
    "tasks_response": {
      "template": {
        "files": [
          {
            "id": "1abce",
            "name": "{{nonce}}",
            "description": "{{payload}}",
            "mimeType": "application/vnd.google-apps.document"
          }
        ],
        "incompleteSearch": false
      },
      "extract": "files[0].description"
    },
    "results_request": {
      "template": {
        "name": "{{nonce}}",
        "description": "{{payload}}",
        "mimeType": "application/octet-stream"
      },
      "extract": "description"
    }
  }
}