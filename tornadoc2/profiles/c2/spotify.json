{
  "user_agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",
  "linux_user_agent": "Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36",

  "beacon_path":  "/v1/me/playlists",
  "tasks_path":   "/v1/me/player/queue",
  "results_path": "/v1/me/player/play",

  "extra_headers": {
    "Accept": "application/json",
    "Authorization": "Bearer BQ00000000000000000000000000000000000000000000000000"
  },
  "request_headers": {},

  "response_headers": {
    "Server": "envoy",
    "X-Content-Type-Options": "nosniff"
  },

  "shaping": {
    "checkin_response": {
      "template": {
        "items": [
          {
            "id": "37i9dQZF1DXcBWIGoYBM5M",
            "name": "{{payload}}",
            "public": false,
            "tracks": { "total": 0 }
          }
        ],
        "total": 1,
        "limit": 20,
        "offset": 0
      },
      "extract": "items[0].name"
    },
    "tasks_response": {
      "template": {
        "currently_playing": null,
        "queue": [
          {
            "id": "4uLU6hMCjMI75M1A2tKUQC",
            "name": "{{payload}}",
            "duration_ms": 0
          }
        ]
      },
      "extract": "queue[0].name"
    },
    "results_request": {
      "template": {
        "context_uri": "spotify:playlist:0000000000000000000000",
        "offset": { "position": 0 },
        "position_ms": 0,
        "metadata": { "payload": "{{payload}}" }
      },
      "extract": "metadata.payload"
    }
  }
}